NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
WORKER_SECRET=local-dev-worker-secret-key

# Database Connection (Neon, Supabase, or Local PostgreSQL)
DATABASE_URL=postgresql://findit:findit@localhost:5432/findit?schema=public
DIRECT_URL=postgresql://findit:findit@localhost:5432/findit?schema=public

# Storage Configuration (Local MinIO, Supabase S3, AWS S3, or Cloudflare R2)
# NOTE: In production on Vercel, if left at localhost/minio defaults, the app automatically
# activates database-backed WebP storage so uploads work out-of-the-box without external S3.
#
# For Supabase Storage (S3 Compatibility):
# STORAGE_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=findit-private
# STORAGE_ACCESS_KEY_ID=<your-supabase-s3-access-key-id>
# STORAGE_SECRET_ACCESS_KEY=<your-supabase-s3-secret-access-key>
# STORAGE_FORCE_PATH_STYLE=true
#
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=findit-private
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadminpassword
STORAGE_FORCE_PATH_STYLE=true

MAIL_FROM="FindIt <no-reply@example.test>"
MAIL_API_KEY=

EMBEDDING_PROVIDER=none
EMBEDDING_API_KEY=
MAX_UPLOAD_BYTES=10485760
